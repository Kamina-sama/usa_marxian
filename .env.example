# Copy to .env and fill in only what you need.
#
# The default pipeline works WITHOUT any key:
#   - FRED keyless CSV endpoint (fredgraph.csv)
#   - BLS public API v1 (no key, limited quota)
#   - BEA NIPA annual flat file
#
# Keys unlock: full FRED API v2, BLS v2 (higher quota / more series), BEA API.
# FRED key (free): https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# BEA key (free): https://apps.bea.gov/API/signup/
BEA_API_KEY=
# BLS key (free): https://data.bls.gov/registrationEngine/
BLS_API_KEY=
# Census key (free): https://api.census.gov/data/key_signup.html
# Required for the regulating-capital / cost-heterogeneity module (ASM, Economic Census).
CENSUS_API_KEY=
